# Copiá este archivo como .env.local (local) o cargá las variables en Vercel.
# Sin ninguna variable, el sitio corre completo en modo simulación.

# --- Sitio ---------------------------------------------------------------
# URL pública (sin barra final). En Vercel se deduce sola si se deja vacía.
NEXT_PUBLIC_SITE_URL=https://wilbertours.vercel.app
# WhatsApp público de Wilber (E.164 sin "+") y cómo se muestra.
NEXT_PUBLIC_WILBER_WHATSAPP=50370000000
NEXT_PUBLIC_WILBER_WHATSAPP_DISPLAY=+503 7000 0000
NEXT_PUBLIC_WILBER_EMAIL=reservas@wilber.sv

# --- Datos -----------------------------------------------------------------
# "simulacion" (por defecto, todo en el navegador) o "supabase".
NEXT_PUBLIC_DATA_MODE=simulacion
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (Kapso) -------------------------------------------------------
KAPSO_API_KEY=
# phone_number_id del número en Kapso (el sandbox también tiene uno).
KAPSO_PHONE_NUMBER_ID=
# Secreto del webhook creado en Kapso (firma X-Webhook-Signature).
KAPSO_WEBHOOK_SECRET=
# Números que pueden recibir mensajes reales desde el simulador (E.164 sin "+", separados por coma).
WHATSAPP_TEST_NUMBERS=
# Número de Wilber: sus mensajes al número de negocio se responden con el bot de comandos.
WILBER_ADMIN_PHONE=

# --- Correo (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Wilber <reservas@tu-dominio.com>
# Correos que pueden recibir envíos reales desde el simulador (separados por coma).
EMAIL_TEST_ADDRESSES=

# --- Pagos (Wompi El Salvador) — pendiente ------------------------------------
# Con estas dos llaves el anticipo en línea abre la pasarela de Wompi.
# URLs a registrar en Wompi: <SITE_URL>/reserva/pago/retorno y <SITE_URL>/api/pagos/wompi/webhook
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
